<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<CompressionEnabled>false</CompressionEnabled>

		<!-- Keep build and publish output out of project content (a publish under the project otherwise copies itself). -->
		<DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.4" />
		<!-- QR encoder/decoder (CPU path only here: the matrix is drawn as an SVG, frames are decoded on the CPU). -->
		<!-- LOCAL feed version (QR decoder fixes, not on nuget.org): never push this to nuget.org. -->
		<PackageReference Include="SpawnDev.ILGPU" Version="5.3.8-local.2" />

		<!-- Reachy Mini client + signalling. LOCAL feed version (Data's unreleased camera chain); never push this to nuget.org. -->
		<PackageReference Include="SpawnDev.Reachy" Version="0.1.0-local.15" />
	</ItemGroup>

</Project>
