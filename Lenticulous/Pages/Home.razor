@page "/"
@implements IDisposable
@inject SpawnJSRuntime JS
@inject NavigationManager Nav
@inject Lenticulous.Services.RobotService Robot

<div class="page">
    <h1>Lenticulous</h1>
    <p class="sub">Recovers the pixel pattern of a lenticular display by scanning it with a webcam.</p>

    <div class="panel">
        <h2>1. Choose the display to scan</h2>
        <p class="muted">Needs the Window Management permission, so the stimulus window can be placed on the 3D display.</p>
        <button @onclick="DetectScreensAsync">Detect screens</button>
        @if (_error != null)
        {
            <p class="bad">@_error</p>
        }
        @if (_screens.Count > 0)
        {
            <table>
                <thead>
                    <tr><th></th><th>Label</th><th>Size</th><th>Position</th><th>Scale</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _screens.Count; i++)
                    {
                        var index = i;
                        var s = _screens[i];
                        <tr class="@(index == _selected ? "sel" : "")" @onclick="() => SelectScreen(index)">
                            <td><input type="radio" checked="@(index == _selected)" /></td>
                            <td>@s.Label @(s.IsPrimary ? "(primary)" : "")</td>
                            <td>@s.Width x @s.Height</td>
                            <td>@s.Left, @s.Top</td>
                            <td>@s.DevicePixelRatio.ToString("0.##")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <button disabled="@(_selected < 0)" @onclick="OpenStimulus">Open stimulus window on selected display</button>
            <p class="muted">In the stimulus window, click once to go fullscreen. Browser scaling must be 100% so one CSS pixel is one display pixel.</p>
        }
    </div>

    <div class="panel">
        <h2>Display details</h2>
        <p class="muted">Screen size comes from you: the display's own EDID is often wrong.</p>
        <div class="form">
            <label>Project name <input @bind="_project.ProjectName" /></label>
            <label>Display name <input @bind="_project.DisplayName" /></label>
            <label>Width (pixels) <input type="number" @bind="_project.WidthPx" /></label>
            <label>Height (pixels) <input type="number" @bind="_project.HeightPx" /></label>
            <label>Screen width (cm) <input type="number" step="0.1" @bind="_project.PhysicalWidthCm" /></label>
            <label>Screen height (cm) <input type="number" step="0.1" @bind="_project.PhysicalHeightCm" /></label>
        </div>
        @if (_project.PixelPitchXmm > 0 && _project.PixelPitchYmm > 0)
        {
            <p class="muted">
                Pixel pitch @_project.PixelPitchXmm.ToString("0.000") x @_project.PixelPitchYmm.ToString("0.000") mm,
                sub-pixel @_project.SubPixelWidthMm.ToString("0.000") mm wide.
            </p>
        }
    </div>

    <div class="panel">
        <h2>2. Robot camera (Reachy Mini)</h2>
        <p class="muted">Check robot only reads status. Wake and Park move the robot; Park uses the confirmed recipe (home, sleep, motors off).</p>
        <input @bind="_robotAddress" size="24" />
        <button @onclick="CheckRobotAsync">Check robot</button>
        <button @onclick="ConnectVideoAsync" disabled="@_busy">Connect video</button>
        <button @onclick="WakeAsync" disabled="@_busy">Wake</button>
        <button @onclick="ParkAsync" disabled="@_busy">Park and disconnect</button>
        <button @onclick="ShowPoseAsync" disabled="@_busy">Read pose</button>
        <button @onclick="FindDisplayAsync" disabled="@_busy">Find display (turns the robot)</button>
        <button @onclick="FindDisplayByCodeAsync" disabled="@_busy">Find display by ID code</button>
        <div class="form">
            <label>Head X (mm) <input type="number" step="any" @bind="_headX" /></label>
            <label>Head Y (mm) <input type="number" step="any" @bind="_headY" /></label>
        </div>
        <button @onclick="MoveHeadAsync" disabled="@_busy">Move head to X / Y (moves the robot)</button>
        @if (_codeText != "")
        {
            <pre>@_codeText</pre>
        }
        @if (_poseText != "")
        {
            <pre>@_poseText</pre>
        }
        @if (_sweepText != "")
        {
            <pre>@_sweepText</pre>
        }
        @if (_robotStatus != null)
        {
            <pre>@_robotStatus</pre>
        }
        <pre>@_videoInfo</pre>
        <div id="camera-host" style="max-width: 640px"></div>
    </div>

    <div class="panel">
        <h2>3. Stimulus window</h2>
        <p class="muted">
            Stimulus windows heard from: @(string.Join(", ", LiveStimulusIds()).Length == 0 ? "none" : string.Join(", ", LiveStimulusIds())).
            Commands go to: <b>@(_targetId == "" ? "all windows" : _targetId)</b>
        </p>
        @foreach (var liveId in LiveStimulusIds())
        {
            var useId = liveId;
            <button @onclick="() => _targetId = useId">Use @useId</button>
        }
        <button @onclick='() => _targetId = ""'>Use all</button>
        <button @onclick='() => Stimulus("close")'>Close the target window</button>
        <button @onclick="ReadCodeAsync" disabled="@_busy">Read the ID code now (no movement)</button>
        @if (_readCodeText != "")
        {
            <pre>@_readCodeText</pre>
        }
        <br />
        <button @onclick='() => Stimulus("fill 255 255 255")'>White</button>
        <button @onclick='() => Stimulus("fill 0 0 0")'>Black</button>
        <button @onclick='() => Stimulus("info 0")'>Hide info</button>
        <button @onclick='() => Stimulus("info 1")'>Show info</button>
        <button @onclick='() => Stimulus("qr 1")'>Show ID code</button>
        <button @onclick='() => Stimulus("qr 0")'>Hide ID code</button>
        <div class="form">
            <label>Pixel X (stimulus window) <input type="number" @bind="_subX" /></label>
            <label>Pixel Y <input type="number" @bind="_subY" /></label>
            <label>
                Colour channel
                <select @bind="_subChannel">
                    <option value="0">Red</option>
                    <option value="1">Green</option>
                    <option value="2">Blue</option>
                </select>
            </label>
        </div>
        <button @onclick="LightSubPixel">Light this sub-pixel (all others off)</button>
        <button @onclick='() => Stimulus("clear")'>Clear</button>
        <p class="muted">Probes read the robot camera (connect video first, do not move the robot):</p>
        <button @onclick="ProbeNoiseAsync" disabled="@_busy">Probe: noise floor</button>
        <button @onclick="ProbePatchAsync" disabled="@_busy">Probe: white 24x24 patch</button>
        <button @onclick="ProbeSubPixelAsync" disabled="@_busy">Probe: this sub-pixel</button>
        @if (_probeText != "")
        {
            <pre>@_probeText</pre>
        }
        <button @onclick="CalibrateAsync" disabled="@_busy">Calibrate (9 white patches)</button>
        <button @onclick="LocateSubPixelsAsync" disabled="@_busy">Locate R, G, B sub-pixels of this pixel</button>
        <button @onclick="ScanRowAsync" disabled="@_busy">Scan a row of 8 pixels from here</button>
        <div class="form">
            <label>Down-the-panel rows (y, comma separated) <input type="text" @bind="_downYList" /></label>
            <label>Window x <input type="number" @bind="_downX" /></label>
            <label>Pixels per window <input type="number" @bind="_acrossPixels" /></label>
            <label>Across: first x <input type="number" @bind="_acrossX0" /></label>
            <label>Across: step (px) <input type="number" @bind="_acrossStep" /></label>
            <label>Across: windows <input type="number" @bind="_acrossCount" /></label>
        </div>
        <button @onclick="ScanDownAsync" disabled="@_busy">Scan the window on each row (no movement)</button>
        @if (_downText != "")
        {
            <pre>@_downText</pre>
        }
        <div class="form">
            <label>Body yaws (deg, comma separated) <input type="text" @bind="_bodyYawList" /></label>
        </div>
        <button @onclick="ScanBodyYawsAsync" disabled="@_busy">At each body yaw: calibrate and scan the across windows (moves the robot)</button>
        @if (_bodyText != "")
        {
            <pre>@_bodyText</pre>
        }
        <button @onclick="ScanAcrossAsync" disabled="@_busy">Scan windows across the panel (no movement)</button>
        @if (_acrossText != "")
        {
            <pre>@_acrossText</pre>
        }
        <div class="form">
            <label>Head Y positions (mm, comma separated) <input type="text" @bind="_headYList" /></label>
        </div>
        <button @onclick="ScanPositionsAsync" disabled="@_busy">Scan the row at each head position (moves the robot)</button>
        @if (_positionsText != "")
        {
            <pre>@_positionsText</pre>
        }
        @if (_rowText != "")
        {
            <pre>@_rowText</pre>
        }
        @if (_calibText != "")
        {
            <pre>@_calibText</pre>
        }
        @if (_locateText != "")
        {
            <pre>@_locateText</pre>
        }
        @if (_stimulusStatus == null)
        {
            <p class="muted">No stimulus window reporting yet.</p>
        }
        else
        {
            <pre>@_stimulusStatus</pre>
        }
    </div>
</div>

@code {
    BroadcastChannel? _channel;
    string? _stimulusStatus;
    string _robotAddress = "192.168.1.170";
    string? _robotStatus;
    readonly DisplayProject _project = new();

    void SelectScreen(int index)
    {
        _selected = index;
        var s = _screens[index];
        // Pixel size is known from the browser. Name is only a suggestion; physical size is left to the user.
        _project.WidthPx = s.Width;
        _project.HeightPx = s.Height;
        if (string.IsNullOrWhiteSpace(_project.DisplayName)) _project.DisplayName = s.Label;
    }

    async Task CheckRobotAsync()
    {
        _robotStatus = "Asking the daemon...";
        StateHasChanged();
        try
        {
            using var client = new SpawnDev.Reachy.ReachyMiniClient(_robotAddress.Trim());
            var status = await client.GetStatusAsync();
            var motors = await client.GetMotorStatusAsync();
            _robotStatus = status == null
                ? $"No daemon answered at {_robotAddress}."
                : $"robot        {status.RobotName}\n" +
                  $"daemon       {status.Version}  state {status.State}\n" +
                  $"wireless     {status.WirelessVersion}  ip {status.WlanIp}\n" +
                  $"motors       {motors?.Mode ?? "unknown"}";
        }
        catch (Exception ex)
        {
            _robotStatus = $"Could not reach {_robotAddress}: {ex.GetType().Name}: {ex.Message}";
        }
    }

    bool _busy;
    string _videoInfo = "";
    readonly List<string> _robotLog = new();
    bool _alive = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (_alive && await timer.WaitForNextTickAsync())
        {
            if (!Robot.VideoConnected) continue;
            var grid = Robot.BrightnessGrid4x4();
            var gridText = grid == null ? "no picture yet"
                : "brightness 4x4: " + string.Join(" | ", Enumerable.Range(0, 4).Select(r => string.Join(" ", grid.Skip(r * 4).Take(4).Select(v => v.ToString().PadLeft(3)))));
            _videoInfo = $"link {Robot.LinkState}\n{Robot.TrackInfo}\n{Robot.VideoElementInfo()}\n{gridText}\n" + string.Join("\n", _robotLog.TakeLast(14));
            StateHasChanged();
        }
    }

    void OnRobotLog(string message)
    {
        _robotLog.Add(message);
        if (_robotLog.Count > 50) _robotLog.RemoveAt(0);
    }

    async Task RunRobotAsync(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try { await action(); }
        catch (Exception ex) { OnRobotLog($"failed: {ex.GetType().Name}: {ex.Message}"); _videoInfo = string.Join("\n", _robotLog.TakeLast(14)); }
        finally { _busy = false; StateHasChanged(); }
    }

    Task ConnectVideoAsync() => RunRobotAsync(() => Robot.ConnectVideoAsync(_robotAddress, "camera-host"));
    Task WakeAsync() => RunRobotAsync(() => Robot.WakeAsync(_robotAddress));
    Task ParkAsync() => RunRobotAsync(async () => { await Robot.DisconnectVideoAsync(); await Robot.ParkAsync(_robotAddress); });

    protected override void OnInitialized()
    {
        Robot.Log += OnRobotLog;
        _channel = new BroadcastChannel(StimulusChannel.Name);
        _channel.OnMessage += OnStimulusMessage;
    }

    void OnStimulusMessage(MessageEvent e)
    {
        var text = e.GetData<string>();
        if (text == null || !text.StartsWith(StimulusChannel.StatusPrefix, StringComparison.Ordinal)) return;
        _stimulusStatus = text.Substring(StimulusChannel.StatusPrefix.Length);
        // The first status line is "id XXXXXXXX": remember every stimulus window that has reported, so a decoded code can be matched.
        var first = _stimulusStatus.Split('\n', 2)[0];
        if (first.StartsWith("id ", StringComparison.Ordinal)) _stimulusIds[first.Substring(3).Trim()] = DateTime.Now;
        StateHasChanged();
    }

    readonly Dictionary<string, DateTime> _stimulusIds = new();
    string _codeText = "";

    /// <summary>
    /// Find which display the camera is looking at by reading its ID code. Tries the current view first, then sweeps the
    /// head (world yaw, body held turned) and stops at the first code that decodes.
    /// </summary>
    Task FindDisplayByCodeAsync() => RunRobotAsync(async () =>
    {
        Stimulus("info 0");
        Stimulus("clear");
        Stimulus("qr 1");
        _codeText = "showing the code, looking...";
        StateHasChanged();
        var rows = new List<string>();
        var heads = new double?[] { null, 90, 75, 60, 45, 30, 15, 0 }; // null = where the head already is
        foreach (var head in heads)
        {
            if (head is { } yaw) await Robot.TurnAsync(_robotAddress, 55, yaw);
            await Task.Delay(1000); // exposure and focus settle after a move
            var pose = await Robot.PoseTextAsync(_robotAddress);
            for (var attempt = 1; attempt <= 3; attempt++)
            {
                var r = Robot.TryDecodeQr();
                rows.Add($"{(head is { } y ? $"head {y,3:0}" : "current   ")} try {attempt}: frame {r.Width}x{r.Height}, decode {r.DecodeMs:0} ms, " + (r.Text == null ? "no code" : $"CODE \"{r.Text}\"") + $"   [{pose}]");
                _codeText = string.Join("\n", rows);
                StateHasChanged();
                if (r.Text != null)
                {
                    var id = r.Text.StartsWith(StimulusChannel.QrPayloadPrefix, StringComparison.Ordinal) ? r.Text.Substring(StimulusChannel.QrPayloadPrefix.Length) : null;
                    var known = id != null && _stimulusIds.ContainsKey(id);
                    rows.Add(known ? $"FOUND display window {id} (one of the stimulus windows reporting to this page), robot left here." : $"decoded \"{r.Text}\" but it is not a known stimulus window id.");
                    _codeText = string.Join("\n", rows);
                    return;
                }
                await Task.Delay(400);
            }
        }
        rows.Add("no code decoded at any position.");
        _codeText = string.Join("\n", rows);
    });

    /// <summary>The stimulus window commands go to. Empty means every window (all of them obey).</summary>
    string _targetId = "";

    void Stimulus(string command)
        => _channel?.PostMessage(StimulusChannel.CommandPrefix + (_targetId == "" ? "" : "@" + _targetId + " ") + command);

    /// <summary>Stimulus windows heard from in the last few seconds (a window reports about twice a second).</summary>
    List<string> LiveStimulusIds() => _stimulusIds.Where(kv => (DateTime.Now - kv.Value).TotalSeconds < 4).Select(kv => kv.Key).OrderBy(i => i).ToList();

    /// <summary>Decode the camera picture right now, without moving anything, and say which stimulus window it shows.</summary>
    string _readCodeText = "";
    Task ReadCodeAsync() => RunRobotAsync(() =>
    {
        var r = Robot.TryDecodeQr();
        var id = r.Text != null && r.Text.StartsWith(StimulusChannel.QrPayloadPrefix, StringComparison.Ordinal) ? r.Text.Substring(StimulusChannel.QrPayloadPrefix.Length) : null;
        _readCodeText = r.Text == null ? $"no code in the picture ({r.Width}x{r.Height}, {r.DecodeMs:0} ms)"
            : $"camera sees code \"{r.Text}\" ({r.DecodeMs:0} ms): " + (id != null && _stimulusIds.ContainsKey(id) ? $"stimulus window {id}" : "not a known stimulus window");
        return Task.CompletedTask;
    });

    int _subX = 100, _subY = 100;
    int _subChannel; // 0 red, 1 green, 2 blue
    string _probeText = "";

    string SubPixelRgb() => _subChannel switch { 0 => "255 0 0", 1 => "0 255 0", _ => "0 0 255" };
    string SubPixelName() => _subChannel switch { 0 => "red", 1 => "green", _ => "blue" };

    // EXPERIMENT: how much light does a lit sub-pixel give this camera? Dark frames, lit frames, and the difference.
    Task ProbeNoiseAsync() => RunRobotAsync(() => ProbeAsync("noise floor (dark vs dark, nothing lit)", () => { }));
    Task ProbePatchAsync() => RunRobotAsync(() => ProbeAsync("white 24x24 patch at (400,300)", () => Stimulus("rect 400 300 24 24 255 255 255")));
    Task ProbeSubPixelAsync() => RunRobotAsync(() => ProbeAsync($"one {SubPixelName()} sub-pixel at ({_subX},{_subY})", () => Stimulus($"px {_subX} {_subY} {SubPixelRgb()}")));

    async Task ProbeAsync(string label, Action light)
    {
        _probeText = $"{label}: darkening the screen...";
        StateHasChanged();
        Stimulus("info 0");
        Stimulus("clear");
        await Task.Delay(1500); // the camera's auto-exposure settles on the dark screen
        var dark = await Robot.CaptureAveragedAsync(12, 40);
        if (dark == null) { _probeText = "no video yet: press Connect video first"; return; }
        _probeText = $"{label}: lighting it...";
        StateHasChanged();
        light();
        await Task.Delay(900);
        var lit = await Robot.CaptureAveragedAsync(12, 40);
        Stimulus("clear");
        var (w, h) = Robot.ProbeSize;
        var report = FrameDifference.Analyze(dark, lit!, w, h);
        static string Mean(float[] f, int c) { double s = 0; for (int i = c; i < f.Length; i += 3) s += f[i]; return (s / (f.Length / 3)).ToString("0.0"); }
        var lines = new List<string>
        {
            label,
            $"frames {w}x{h}, 12 averaged per capture; mean RGB dark {Mean(dark, 0)}/{Mean(dark, 1)}/{Mean(dark, 2)}, lit {Mean(lit!, 0)}/{Mean(lit!, 1)}/{Mean(lit!, 2)}",
            $"noise sigma of the difference (robust): {report.NoiseStd:0.000}",
        };
        var channelNames = new[] { "R", "G", "B" };
        foreach (var p in report.Peaks)
            lines.Add($"  peak at camera pixel ({p.X},{p.Y}) channel {channelNames[p.Channel]}: +{p.Value:0.00} = {(report.NoiseStd > 0 ? p.Value / report.NoiseStd : 0):0.0} sigma");
        lines.Add($"strongest peak over noise: {report.SignalToNoise:0.0}");
        _probeText = string.Join("\n", lines);
    }

    // CALIBRATION: where on the camera picture does a stimulus pixel show up? Nine white patches on a grid, each located in the picture
    // by its centre of light, then a projective fit stimulus -> camera.
    Homography? _calib;
    string _calibText = "";
    Task CalibrateAsync() => RunRobotAsync(() => DoCalibrateAsync(new[] { 200, 520, 840 }, new[] { 400, 560, 720 }));

    /// <summary>Nine patches on the given grid; true when at least four were seen and the fit is stored in <c>_calib</c>.</summary>
    async Task<bool> DoCalibrateAsync(int[] gridX, int[] gridY)
    {
        _calibText = "calibrating: darkening...";
        StateHasChanged();
        Stimulus("info 0");
        Stimulus("clear");
        await Task.Delay(1500);
        var dark = await Robot.CaptureAveragedAsync(12, 40);
        if (dark == null) { _calibText = "no video yet: press Connect video first"; return false; }
        var (w, h) = Robot.ProbeSize;
        var from = new List<(double X, double Y)>();
        var to = new List<(double X, double Y)>();
        var peaks = new List<FrameDifference.Blob>();
        var lines = new List<string>();
        foreach (var y in gridY)
            foreach (var x in gridX)
            {
                Stimulus("clear");
                Stimulus($"rect {x - 12} {y - 12} 24 24 255 255 255");
                await Task.Delay(800);
                var lit = await Robot.CaptureAveragedAsync(8, 40);
                var blob = FrameDifference.BlobCentroid(dark, lit!, w, h);
                if (blob == null) { lines.Add($"stimulus ({x},{y}): not seen"); continue; }
                from.Add((x, y));
                to.Add((blob.Value.X, blob.Value.Y));
                peaks.Add(blob.Value);
                lines.Add($"stimulus ({x},{y}) -> camera ({blob.Value.X:0.0},{blob.Value.Y:0.0})  +{blob.Value.Peak:0} size {blob.Value.Width}x{blob.Value.Height}");
                _calibText = string.Join("\n", lines);
                StateHasChanged();
            }
        Stimulus("clear");
        // A patch that is off the camera's picture (or hidden) leaves only noise: its "blob" is small and weak. Keep the real ones,
        // those at least half as strong as the strongest and of sensible size.
        if (peaks.Count > 0)
        {
            var strongest = peaks.Max(p => p.Peak);
            for (int i = peaks.Count - 1; i >= 0; i--)
                if (peaks[i].Peak < strongest * 0.5 || peaks[i].Pixels < 100)
                {
                    lines.Add($"ignored stimulus ({from[i].X:0},{from[i].Y:0}): too weak or too small to be the patch");
                    from.RemoveAt(i); to.RemoveAt(i); peaks.RemoveAt(i);
                }
        }
        if (from.Count < 4) { lines.Add($"only {from.Count} patches seen: cannot fit"); _calibText = string.Join("\n", lines); return false; }
        _calib = Homography.Fit(from, to);
        var (ax, ay) = _calib.Map(from[0].X, from[0].Y);
        var (bx, by) = _calib.Map(from[0].X + 1, from[0].Y + 1);
        lines.Add($"fit from {from.Count} patches, RMS residual {_calib.RmsError(from, to):0.00} camera px; one stimulus pixel = {bx - ax:0.00} x {by - ay:0.00} camera px");
        _calibText = string.Join("\n", lines);
        return true;
    }

    // Where does a lit sub-pixel show up, and does it stand out? Each colour channel of the pixel is lit in turn; the predicted
    // camera position is searched, and the same place is searched in a dark-versus-dark control taken at the same moment.
    string _locateText = "";
    Task LocateSubPixelsAsync() => RunRobotAsync(async () =>
    {
        if (_calib == null) { _locateText = "calibrate first"; return; }
        _locateText = "locating: darkening...";
        StateHasChanged();
        Stimulus("info 0");
        Stimulus("clear");
        await Task.Delay(1500);
        var dark1 = await Robot.CaptureAveragedAsync(12, 40);
        if (dark1 == null) { _locateText = "no video yet"; return; }
        var dark2 = await Robot.CaptureAveragedAsync(12, 40);
        var (w, h) = Robot.ProbeSize;
        var lines = new List<string>();
        var names = new[] { "R", "G", "B" };
        for (int c = 0; c < 3; c++)
        {
            var (cx, cy) = _calib.Map(_subX + (c + 0.5) / 3.0, _subY + 0.5);
            var rgb = c == 0 ? "255 0 0" : c == 1 ? "0 255 0" : "0 0 255";
            Stimulus($"px {_subX} {_subY} {rgb}");
            await Task.Delay(900);
            var lit = await Robot.CaptureAveragedAsync(12, 40);
            Stimulus("clear");
            var real = FrameDifference.AnalyzeRegion(dark1, lit!, w, h, 3, cx, cy, 6);
            var control = FrameDifference.AnalyzeRegion(dark1, dark2!, w, h, 3, cx, cy, 6);
            lines.Add($"{names[c]} sub-pixel at ({_subX},{_subY}) predicted camera ({cx:0.0},{cy:0.0}):");
            lines.Add($"   lit      peak +{real.RoiPeak.Value:0.0} in {names[real.RoiPeak.Channel]} at ({real.RoiPeak.X},{real.RoiPeak.Y}); {real.WindowsAtLeastAsBright} of {real.WindowsTotal} other windows as bright; sums R/G/B {real.ChannelSum[0]:0}/{real.ChannelSum[1]:0}/{real.ChannelSum[2]:0}; noise {real.NoiseStd:0.00}");
            lines.Add($"   control  peak +{control.RoiPeak.Value:0.0} in {names[control.RoiPeak.Channel]} at ({control.RoiPeak.X},{control.RoiPeak.Y}); {control.WindowsAtLeastAsBright} of {control.WindowsTotal} other windows as bright; sums R/G/B {control.ChannelSum[0]:0}/{control.ChannelSum[1]:0}/{control.ChannelSum[2]:0}");
            _locateText = string.Join("\n", lines);
            StateHasChanged();
        }
    });

    // ROW SCAN at the current camera pose: 8 pixels (24 sub-pixels) starting at the X/Y above, each lit alone, each measured at its
    // predicted camera position. One camera position's view profile along a stretch of the panel.
    string _rowText = "";
    double[]? _rowProfile;
    Task ScanRowAsync() => RunRobotAsync(() => DoRowScanAsync(_subX, 8));

    // SYNC MARKER (TJ's method): every frame the stimulus shows carries a numbered marker, drawn in the same render as the lit pixel.
    // The camera polls the marker; when it reads the number just sent, the pixel is on, whatever the link's latency.
    int _seq;
    /// <summary>Where the marker's first block sits in the stimulus window: a spot the camera sees, clear of the rows being scanned.</summary>
    int _markerX = 250, _markerY = 560;
    readonly List<int> _latenciesMs = new();
    int _markerMisses, _markerChanged;

    /// <summary>Camera-picture centres of the marker's blocks (needs the calibration), black reference first.</summary>
    List<(double X, double Y)> MarkerCentres(int mx, int my)
        => Enumerable.Range(0, SyncMarker.BlockCount)
            .Select(i => _calib!.Map(mx + i * SyncMarker.BlockPitch + SyncMarker.BlockSize / 2.0, my + SyncMarker.BlockSize / 2.0)).ToList();

    /// <summary>
    /// Show one frame: the marker with the next sequence number, plus the pixel (pixelX &lt; 0: nothing lit). Returns once the camera
    /// has read that number, with the milliseconds it took, or -1 when it never did.
    /// </summary>
    async Task<int> ShowFrameAsync(int pixelX, int pixelY, string rgb)
    {
        _seq = _seq % SyncMarker.MaxSequence + 1;
        int mx = _markerX, my = _markerY;
        var centres = MarkerCentres(mx, my);
        var clock = System.Diagnostics.Stopwatch.StartNew();
        Stimulus($"frame {_seq} {mx} {my} {pixelX} {pixelY} {rgb}");
        while (clock.ElapsedMilliseconds < 3000)
        {
            await Task.Delay(20);
            var luma = Robot.SampleLuma(centres, 3);
            if (luma != null && SyncMarker.Decode(luma) == _seq)
            {
                _latenciesMs.Add((int)clock.ElapsedMilliseconds);
                return (int)clock.ElapsedMilliseconds;
            }
        }
        _markerMisses++;
        return -1;
    }

    /// <summary>True when the camera still reads the marker of the last frame shown (the picture it just averaged was that frame).</summary>
    bool MarkerStillShown()
    {
        var luma = Robot.SampleLuma(MarkerCentres(_markerX, _markerY), 3);
        var still = luma != null && SyncMarker.Decode(luma) == _seq;
        if (!still) _markerChanged++;
        return still;
    }

    /// <summary>One row of <paramref name="pixels"/> pixels from (xStart,_subY) at the current pose; null when it cannot run.</summary>
    async Task<double[]?> DoRowScanAsync(int xStart, int pixels)
    {
        if (_calib == null) { _rowText = "calibrate first"; return null; }
        _rowText = "row scan: darkening...";
        StateHasChanged();
        Stimulus("info 0");
        _latenciesMs.Clear(); _markerMisses = 0; _markerChanged = 0;
        if (await ShowFrameAsync(-1, 0, "0 0 0") < 0) { _rowText = "the camera never read the sync marker (is the marker in view and the calibration good?)"; return null; }
        await Task.Delay(400); // the camera's auto-exposure settles on the dark frame
        var dark = await Robot.CaptureAveragedAsync(12, 40);
        if (dark == null) { _rowText = "no video yet"; return null; }
        var (w, h) = Robot.ProbeSize;
        var values = new double[pixels * 3];
        var started = DateTime.Now;
        for (int i = 0; i < pixels * 3; i++)
        {
            int px = xStart + i / 3, c = i % 3;
            var (cx, cy) = _calib.Map(px + (c + 0.5) / 3.0, _subY + 0.5);
            // The marker says the frame is up; a short settle covers the camera exposing across the change and the LCD's response.
            if (await ShowFrameAsync(px, _subY, c == 0 ? "255 0 0" : c == 1 ? "0 255 0" : "0 0 255") < 0) { values[i] = double.NaN; continue; }
            await Task.Delay(120);
            var lit = await Robot.CaptureAveragedAsync(6, 40);
            var valid = MarkerStillShown();
            values[i] = valid ? FrameDifference.RegionChannelSums(dark, lit!, w, h, 3, cx, cy, 4)[c] : double.NaN;
            _rowText = $"row scan: sub-pixel {i + 1} of {pixels * 3}...";
            StateHasChanged();
        }
        Stimulus("clear");
        // The same dark frame again at the end: how far the baseline drifted while scanning.
        await ShowFrameAsync(-1, 0, "0 0 0");
        await Task.Delay(400);
        var dark2 = await Robot.CaptureAveragedAsync(12, 40);
        var driftAt = _calib.Map(xStart + 0.5, _subY + 0.5);
        var drift = FrameDifference.RegionChannelSums(dark, dark2!, w, h, 3, driftAt.X, driftAt.Y, 4);
        _rowProfile = values;
        var max = values.Where(v => !double.IsNaN(v)).DefaultIfEmpty(1).Max();
        var sorted = _latenciesMs.OrderBy(v => v).ToList();
        var latency = sorted.Count == 0 ? "no marker read" : $"marker read after {sorted[0]} / {sorted[sorted.Count / 2]} / {sorted[^1]} ms (min / median / max over {sorted.Count} frames)";
        var lines = new List<string>
        {
            $"row scan at y={_subY}, pixels {xStart}..{xStart + pixels - 1},{(DateTime.Now - started).TotalSeconds:0} s; region sum of the lit channel (camera counts); end-of-scan dark drift R/G/B {drift[0]:0}/{drift[1]:0}/{drift[2]:0}",
            $"sync: {latency}; never seen {_markerMisses}; marker changed during a capture {_markerChanged} (those points are blank)",
        };
        for (int i = 0; i < values.Length; i++)
            lines.Add(double.IsNaN(values[i])
                ? $"  px {xStart + i / 3} {"RGB"[i % 3]}   (no valid reading)"
                : $"  px {xStart + i / 3} {"RGB"[i % 3]} {values[i],7:0}  {new string('#', Math.Max(0, (int)Math.Round(values[i] / max * 40)))}");
        _rowText = string.Join("\n", lines);
        return values;
    }

    // ACROSS THE PANEL (no robot movement): close to the display, columns across the camera's picture are seen at very different
    // angles, so one fixed camera sees the whole view fan along a row. Short windows of pixels at spaced columns are scanned; the
    // bright sub-pixels drifting from window to window is the view response over angle.
    int _acrossX0 = 240, _acrossStep = 40, _acrossCount = 18, _acrossPixels = 6;
    string _acrossText = "";
    readonly List<(int X, double[] Profile)> _acrossProfiles = new();
    Task ScanAcrossAsync() => RunRobotAsync(DoAcrossAsync);

    async Task DoAcrossAsync()
    {
        _acrossProfiles.Clear();
        var lines = new List<string> { $"row y={_subY}: windows of {_acrossPixels} pixels ({_acrossPixels * 3} sub-pixels R,G,B) every {_acrossStep} px from x={_acrossX0}; values in hundreds, '#' = over 40% of the window's brightest" };
        for (int j = 0; j < _acrossCount; j++)
        {
            int x = _acrossX0 + j * _acrossStep;
            var profile = await DoRowScanAsync(x, _acrossPixels);
            if (profile == null) { lines.Add($"x={x}: scan failed"); break; }
            _acrossProfiles.Add((x, profile));
            var max = profile.Where(v => !double.IsNaN(v)).DefaultIfEmpty(1).Max();
            lines.Add($"x={x,4}  " + string.Join(" ", profile.Select(v => double.IsNaN(v) ? "  ?" : ((int)Math.Round(v / 100)).ToString().PadLeft(3))));
            lines.Add("        " + string.Join(" ", profile.Select(v => !double.IsNaN(v) && v > max * 0.4 ? "  #" : "  .")));
            _acrossText = string.Join("\n", lines);
            StateHasChanged();
        }
        _acrossText = string.Join("\n", lines);
    }

    // BODY ARC: the head holds its world orientation while the body turns, so the camera swings sideways along an arc (a large
    // lateral move with the same viewing direction). At each body yaw: calibrate, then scan the across windows; everything is logged.
    string _bodyYawList = "-20,-10,0,10,20";
    string _bodyText = "";
    Task ScanBodyYawsAsync() => RunRobotAsync(async () =>
    {
        var log = new List<string>();
        foreach (var token in _bodyYawList.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (!double.TryParse(token, System.Globalization.CultureInfo.InvariantCulture, out var yaw)) continue;
            _bodyText = string.Join("\n", log) + $"\n== body yaw {yaw}: turning...";
            StateHasChanged();
            await Robot.TurnAsync(_robotAddress, yaw, 0);
            var pose = await Robot.PoseTextAsync(_robotAddress);
            var ok = await DoCalibrateAsync(new[] { 200, 520, 840 }, new[] { 400, 560, 720 });
            log.Add($"== body yaw {yaw}: {pose}");
            log.Add(_calibText);
            if (!ok) { log.Add("calibration failed"); _bodyText = string.Join("\n", log); continue; }
            await DoAcrossAsync();
            log.Add(_acrossText);
            _bodyText = string.Join("\n", log);
            StateHasChanged();
        }
        _bodyText = string.Join("\n", log);
    });

    // DOWN THE PANEL: the same window of pixels on several rows. A slanted lens shifts the bright set from row to row; how far per row
    // is the slant.
    int _downX = 520;
    string _downYList = "440,441,442,443,444,445,446,447";
    string _downText = "";
    Task ScanDownAsync() => RunRobotAsync(async () =>
    {
        var keep = _subY;
        var lines = new List<string> { $"x={_downX}, {_acrossPixels} pixels ({_acrossPixels * 3} sub-pixels R,G,B), values in hundreds" };
        foreach (var token in _downYList.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (!int.TryParse(token, out var y)) continue;
            _subY = y;
            var profile = await DoRowScanAsync(_downX, _acrossPixels);
            if (profile == null) { lines.Add($"y={y}: scan failed"); break; }
            lines.Add($"y={y,4}  " + string.Join(" ", profile.Select(v => double.IsNaN(v) ? "  ?" : ((int)Math.Round(v / 100)).ToString().PadLeft(3))));
            _downText = string.Join("\n", lines);
            StateHasChanged();
        }
        _subY = keep;
        _downText = string.Join("\n", lines);
    });

    // SEVERAL CAMERA POSITIONS: for each head Y (mm) in the list the head moves, a local calibration (9 patches around the row)
    // re-finds the display in the picture, and the row is scanned. The profiles are what the view assignment is built from.
    string _headYList = "-12,-6,0,6,12";
    string _positionsText = "";
    readonly List<(double HeadY, string Pose, double[] Profile)> _positionProfiles = new();
    Task ScanPositionsAsync() => RunRobotAsync(async () =>
    {
        _positionProfiles.Clear();
        var lines = new List<string>();
        foreach (var token in _headYList.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (!double.TryParse(token, System.Globalization.CultureInfo.InvariantCulture, out var y)) continue;
            _positionsText = string.Join("\n", lines) + $"\nhead Y {y}: moving...";
            StateHasChanged();
            await Robot.MoveHeadAsync(_robotAddress, _headX, y);
            var pose = await Robot.PoseTextAsync(_robotAddress);
            var ok = await DoCalibrateAsync(new[] { _subX - 130, _subX, _subX + 130 }, new[] { _subY - 100, _subY, _subY + 100 });
            if (!ok) { lines.Add($"head Y {y}: {pose}: calibration failed"); continue; }
            var profile = await DoRowScanAsync(_subX, 8);
            if (profile == null) { lines.Add($"head Y {y}: scan failed"); continue; }
            _positionProfiles.Add((y, pose, profile));
            lines.Add($"head Y {y}: {pose}");
            lines.Add("   " + string.Join(" ", profile.Select(v => double.IsNaN(v) ? "  ?" : ((int)Math.Round(v / 100)).ToString().PadLeft(3))) + "   (hundreds, sub-pixels R G B per pixel; ? = no valid reading)");
        }
        _positionsText = string.Join("\n", lines);
    });

    /// <summary>
    /// Black screen, then exactly one colour channel of one pixel at full brightness: one sub-pixel lit, every neighbour off. The
    /// coordinates are the stimulus window's own (CSS pixels, which are panel pixels at scale 1).
    /// </summary>
    void LightSubPixel()
    {
        Stimulus("info 0");
        Stimulus("clear");
        Stimulus($"px {_subX} {_subY} {SubPixelRgb()}");
    }

    string _poseText = "";
    string _sweepText = "";

    Task ShowPoseAsync() => RunRobotAsync(async () => _poseText = await Robot.PoseTextAsync(_robotAddress));

    // Head position (mm, the daemon's head frame). The camera is on the head, so this is the sideways travel the scan needs.
    double _headX, _headY;
    Task MoveHeadAsync() => RunRobotAsync(async () =>
    {
        await Robot.MoveHeadAsync(_robotAddress, _headX, _headY);
        _poseText = await Robot.PoseTextAsync(_robotAddress);
    });

    /// <summary>
    /// Turn the robot in steps and read the picture's brightness at each: the white stimulus window is the brightest
    /// large thing in the room, so the step where the mean peaks is where the robot faces the display.
    /// </summary>
    Task FindDisplayAsync() => RunRobotAsync(async () =>
    {
        _sweepText = "sweeping...";
        StateHasChanged();
        var rows = new List<string>();
        // Positive yaw is left. MEASURED 2026-10-15 (TJ watching the robot): the commanded head yaw is a WORLD yaw, not
        // relative to the body - turning the body under a head at 0 left the head facing forward. So the body is held
        // turned (max about 56 deg, and it must stay within about 65 deg of the head) and the head's world yaw sweeps.
        var steps = new List<(double Body, double Head)> { (55, 0), (55, 15), (55, 30), (55, 45), (55, 60), (55, 75), (55, 90) };
        var best = (Body: 0d, Head: 0d, Mean: double.MinValue);
        foreach (var (body, head) in steps)
        {
            await Robot.TurnAsync(_robotAddress, body, head);
            await Task.Delay(600); // let the picture settle after the move
            var mean = Robot.MeanBrightness() ?? double.NaN;
            var pose = await Robot.PoseTextAsync(_robotAddress);
            rows.Add($"commanded body {body,3:0} head {head,3:0}  mean brightness {mean,6:0.0}   read back: {pose}");
            if (mean > best.Mean) best = (body, head, mean);
            _sweepText = string.Join("\n", rows);
            StateHasChanged();
        }
        await Robot.TurnAsync(_robotAddress, best.Body, best.Head);
        rows.Add($"brightest at body {best.Body:0} head {best.Head:0} (mean {best.Mean:0.0}); robot left there");
        _sweepText = string.Join("\n", rows);
    });

    public void Dispose()
    {
        _alive = false;
        Robot.Log -= OnRobotLog;
        if (_channel == null) return;
        _channel.OnMessage -= OnStimulusMessage;
        _channel.Close();
        _channel.Dispose();
        _channel = null;
    }

    record ScreenInfo(string Label, int Width, int Height, int Left, int Top, double DevicePixelRatio, bool IsPrimary);

    readonly List<ScreenInfo> _screens = new();
    int _selected = -1;
    string? _error;

    async Task DetectScreensAsync()
    {
        _error = null;
        _screens.Clear();
        _selected = -1;
        try
        {
            using var window = JS.Get<Window>("window");
            using var details = await window.GetScreenDetails();
            using var screens = details.Screens;
            foreach (var s in screens.ToArray<ScreenDetailed>())
            {
                _screens.Add(new ScreenInfo(s.Label, s.Width, s.Height, s.Left, s.Top, s.DevicePixelRatio, s.IsPrimary));
                s.Dispose();
            }
        }
        catch (Exception ex)
        {
            _error = "Could not read screens: " + ex.Message;
        }
    }

    void OpenStimulus()
    {
        if (_selected < 0 || _selected >= _screens.Count) return;
        var s = _screens[_selected];
        var url = new Uri(new Uri(Nav.BaseUri), "stimulus").ToString();
        // popup=yes + left/top/width/height places the window on the chosen monitor (needs the Window Management permission)
        var features = $"popup=yes,left={s.Left},top={s.Top},width={s.Width},height={s.Height}";
        using var window = JS.Get<Window>("window");
        window.Open(url, "lenticulous-stimulus", features)?.Dispose();
    }
}
